# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_wms"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# CORS — domain của frontend được phép gọi API (nhiều domain cách nhau bởi dấu phẩy).
# Để trống khi chạy local (mặc định cho phép tất cả).
# Khi deploy: dán domain Vercel thật vào, ví dụ https://wms.vercel.app
FRONTEND_URL=