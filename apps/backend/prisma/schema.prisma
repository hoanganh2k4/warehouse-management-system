generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== Identity =====================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  fullName     String?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  transactions      Transaction[]
  schedulesCreated  Schedule[]    @relation("ScheduleCreatedBy")
  schedulesExecuted Schedule[]    @relation("ScheduleExecutedBy")

  @@index([roleId])
  @@map("users")
}

// ===================== Catalog =====================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id         String    @id @default(uuid())
  skuCode    String    @unique
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  unit       String
  isHeavy    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  batches   Batch[]
  slots     Slot[]     @relation("SlotCurrentProduct")
  schedules Schedule[]

  @@index([categoryId])
  @@map("products")
}

model Batch {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  batchCode       String   @unique
  manufactureDate DateTime
  expiryDate      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventories         Inventory[]
  transactions        Transaction[]
  schedulesSugg       Schedule[]           @relation("ScheduleSuggestedBatch")
  schedulesActual     Schedule[]           @relation("ScheduleActualBatch")
  scheduleAllocations ScheduleAllocation[]

  @@index([productId])
  @@index([expiryDate])
  @@map("batches")
}

// ===================== Partners (Nhà cung cấp / Khách hàng) =====================

model Supplier {
  id          String    @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  schedules Schedule[]

  @@map("suppliers")
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  schedules Schedule[]

  @@map("customers")
}

// ===================== Warehouse =====================

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String?
  zones     Zone[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouse")
}

model Zone {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  racks       Rack[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, code])
  @@map("zones")
}

model Rack {
  id        String   @id @default(uuid())
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id])
  code      String
  levels    Level[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, code])
  @@map("racks")
}

model Level {
  id          String   @id @default(uuid())
  rackId      String
  rack        Rack     @relation(fields: [rackId], references: [id])
  levelNumber Int
  slots       Slot[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rackId, levelNumber])
  @@map("levels")
}

model Slot {
  id                     String   @id @default(uuid())
  levelId                String
  level                  Level    @relation(fields: [levelId], references: [id])
  code                   String
  maxCapacity            Int
  usedCapacity           Int      @default(0)
  availableCapacity      Int
  occupancyRate          Float    @default(0)
  currentProductId       String?
  currentProduct         Product? @relation("SlotCurrentProduct", fields: [currentProductId], references: [id])
  distanceToGate         Float
  outboundFrequencyScore Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  inventories         Inventory[]
  transactionsIn      Transaction[]        @relation("SlotTo")
  transactionsOut     Transaction[]        @relation("SlotFrom")
  schedulesSugg       Schedule[]           @relation("ScheduleSuggestedSlot")
  schedulesActual     Schedule[]           @relation("ScheduleActualSlot")
  scheduleAllocations ScheduleAllocation[]

  @@unique([levelId, code])
  @@index([currentProductId])
  @@map("slots")
}

// ===================== Inventory =====================

model Inventory {
  id        String   @id @default(uuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id])
  slotId    String
  slot      Slot     @relation(fields: [slotId], references: [id])
  quantity  Int
  updatedAt DateTime @updatedAt

  @@unique([batchId, slotId])
  @@index([slotId])
  @@map("inventory")
}

// ===================== Operation =====================

enum TransactionType {
  IMPORT
  EXPORT
  MOVE
}

model Transaction {
  id         String          @id @default(uuid())
  type       TransactionType
  batchId    String
  batch      Batch           @relation(fields: [batchId], references: [id])
  slotFromId String?
  slotFrom   Slot?           @relation("SlotFrom", fields: [slotFromId], references: [id])
  slotToId   String?
  slotTo     Slot?           @relation("SlotTo", fields: [slotToId], references: [id])
  quantity   Int

  // Tồn kho tại slot liên quan TRƯỚC giao dịch (Task 91 sẽ điền)
  quantityBefore Int?
  // Tồn kho tại slot liên quan SAU giao dịch (Task 91 sẽ điền)
  quantityAfter  Int?
  // Thứ tự trong ngày, dùng để sort liên tiếp (Task 91/93)
  dailySeq       Int?

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  note      String?
  createdAt DateTime @default(now())

  schedule Schedule?

  @@index([batchId])
  @@index([type])
  @@index([createdAt, dailySeq])
  @@map("transactions")
}

// ===================== Scheduling (Đặt lịch nhập/xuất) =====================

enum ScheduleType {
  INBOUND
  OUTBOUND
}

enum ScheduleStatus {
  PENDING // Chờ thực hiện
  IN_PROGRESS // Đang thực hiện
  COMPLETED // Hoàn thành
  CANCELLED // Đã hủy
}

// Cách vị trí lưu (nhập) hoặc lấy hàng (xuất) cuối cùng được xác định.
enum AllocationMethod {
  SMART_ALLOCATION
  MANUAL_OVERRIDE
}

enum SelectionMethod {
  FEFO
  MANUAL_OVERRIDE
}

// Lý do nhân viên tự đổi vị trí so với đề xuất của Smart WMS.
enum ScheduleOverrideReason {
  SLOT_MAINTENANCE // Slot đang bảo trì
  SLOT_FULL // Slot đã đầy
  FORKLIFT_UNAVAILABLE // Xe nâng không thể tiếp cận
  MANAGEMENT_REQUEST // Theo yêu cầu quản lý
  OTHER // Khác (dùng kèm overrideReasonNote)
}

enum AllocationKind {
  SUGGESTED
  ACTUAL
}

model Schedule {
  id     String         @id @default(uuid())
  type   ScheduleType
  status ScheduleStatus @default(PENDING)

  // Ngày + giờ dự kiến nhập/xuất (gộp làm 1 DateTime, FE tách hiển thị Ngày/Giờ riêng)
  scheduledAt DateTime

  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  // Mã lô hàng do người dùng nhập tay khi đặt lịch (không bắt buộc)
  batchCode String?

  // Mã đơn riêng, tự sinh, dùng để tra cứu (Task 92)
  orderCode  String?   @unique
  // HSD lô hàng, thu ngay lúc đặt lịch (chỉ dùng khi type = INBOUND)
  expiryDate DateTime?

  // Nhập kho -> supplier bắt buộc; Xuất kho -> customer bắt buộc (kiểm tra ở tầng service/DTO)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  note String?

  // ---- Smart Suggestion (snapshot tại thời điểm đặt lịch, chỉ mang tính tham khảo) ----
  suggestedSlotId   String?
  suggestedSlot     Slot?     @relation("ScheduleSuggestedSlot", fields: [suggestedSlotId], references: [id])
  suggestedBatchId  String? // Chỉ dùng cho Outbound: Batch được FEFO đề xuất
  suggestedBatch    Batch?    @relation("ScheduleSuggestedBatch", fields: [suggestedBatchId], references: [id])
  suggestionScore   Float? // % độ phù hợp
  suggestionReasons String[] // Danh sách lý do đề xuất, hiển thị dạng "✓ ..."
  suggestedAt       DateTime?

  // ---- Kết quả thực tế khi người dùng nhấn "Thực hiện" và xác nhận ----
  actualSlotId       String?
  actualSlot         Slot?                   @relation("ScheduleActualSlot", fields: [actualSlotId], references: [id])
  actualBatchId      String?
  actualBatch        Batch?                  @relation("ScheduleActualBatch", fields: [actualBatchId], references: [id])
  allocationMethod   AllocationMethod? // Nhập kho
  selectionMethod    SelectionMethod? // Xuất kho
  overrideReason     ScheduleOverrideReason?
  overrideReasonNote String? // Khi overrideReason = OTHER

  executedById String?
  executedBy   User?     @relation("ScheduleExecutedBy", fields: [executedById], references: [id])
  executedAt   DateTime?

  // Transaction được sinh ra sau khi xác nhận thực hiện (1-1)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  // Danh sách đầy đủ vị trí/lô được gợi ý hoặc thực hiện (Task 98-99)
  allocations ScheduleAllocation[]

  createdById String
  createdBy   User     @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cancelledAt  DateTime?
  cancelReason String?

  @@index([type])
  @@index([status])
  @@index([scheduledAt])
  @@index([productId])
  @@map("schedules")
}

model ScheduleAllocation {
  id         String         @id @default(uuid())
  scheduleId String
  schedule   Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  kind       AllocationKind

  slotId String
  slot   Slot   @relation(fields: [slotId], references: [id])

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id])

  quantity  Int
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([scheduleId, kind])
  @@map("schedule_allocations")
}
